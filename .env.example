# Copy this file to .env and set secure values before running

# Database (Postgres)
DATABASE_CLIENT=postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi_password

# Strapi secrets (replace with secure random values)
APP_KEYS=replace_with_random_app_keys
API_TOKEN_SALT=replace_with_random_salt
ADMIN_JWT_SECRET=replace_with_admin_jwt_secret
JWT_SECRET=replace_with_jwt_secret

# App
PORT=1337
NODE_ENV=production
